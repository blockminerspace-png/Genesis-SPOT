# Copiar para .env na VM (spot.genesisdao.tech) e preencher segredos.
# Depois: docker compose -f docker-compose.prod.yml up -d --build
# Migração: docker compose -f docker-compose.prod.yml exec app npx prisma migrate deploy

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://bot:bot@postgres:5432/botspot

COINEX_ACCESS_ID=
COINEX_SECRET_KEY=

MARKET_DATA_SOURCE=COINEX
PORTFOLIO_BALANCE_SOURCE=COINEX

ENABLE_LIVE_TRADING=true
ENABLE_AUTO_LIVE_WORKER=true
AUTO_LIVE_CONFIRM_ENV=I_UNDERSTAND_THIS_BOT_CAN_TRADE_REAL_MONEY
AUTO_LIVE_ORDER_QUOTE_VALUE=1
AUTO_LIVE_TARGET_PROFIT_PCT=0.02
AUTO_LIVE_MARKET=
# Só inclua pares que o Auto LIVE deve negociar (CSV). Um par = só esse mercado.
LIVE_MARKET_ALLOWLIST=BTCUSDC
LIVE_MAX_ORDER_QUOTE_VALUE=30
LIVE_MAX_DAILY_QUOTE_VOLUME=500
LIVE_REQUIRE_MAKER_ONLY=false

BOT_MARKET=BTCUSDC
BOT_ENABLED=true
BOT_ORDER_QUOTE_SIZE=1
BOT_TARGET_PROFIT_PCT=0.02
BOT_GRID_STEP_PCT=0.02
BOT_FEE_BUFFER_PCT=0
BOT_MIN_QUOTE_BALANCE=5

# Estratégia BTC Drop 2K
BTC_STRATEGY_ENABLED=true
BTC_STRATEGY_MARKET=BTCUSDC
BTC_ORDER_BASE_AMOUNT=0.0001
BTC_DROP_BUY_STEP_USDT=2000
BTC_TARGET_PROFIT_PCT=0.02

DASHBOARD_AUTH_ENABLED=true
DASHBOARD_JWT_SECRET=
DASHBOARD_USERS=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
