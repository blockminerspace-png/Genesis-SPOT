NODE_ENV=development
# Só aceita conexões na máquina local. Para aceitar LAN/WAN use HOST=0.0.0.0
HOST=127.0.0.1
# Dashboard + API: http://localhost:3000 (ajuste PORT se precisar).
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://bot:bot@localhost:5433/botspot
# Host 5433 → container 5432 (evita conflito se já houver Postgres na 5432).

COINEX_BASE_URL=https://api.coinex.com/v2
COINEX_ACCESS_ID=
COINEX_SECRET_KEY=

# Ticker e saldos: sempre CoinEx (read-only para saldo).
MARKET_DATA_SOURCE=COINEX
MARKET_DATA_CACHE_TTL_MS=2000
# Cache do spec (precisão / mínimos / fees) em ms.
MARKET_SPEC_CACHE_TTL_MS=120000

PORTFOLIO_BALANCE_SOURCE=COINEX
PORTFOLIO_BALANCE_CACHE_TTL_MS=5000

# --- LIVE (Fase 1.6): ordem real só com ENABLE_LIVE_TRADING=true + Postgres LIVE + travas ---
ENABLE_LIVE_TRADING=false
# CSV — pares spot. Com BTC Drop 2K use só BTCUSDT.
LIVE_MARKET_ALLOWLIST=BTCUSDT
# 0,0001 BTC a ~100k ≈ 10 USDT por ordem — não uses 1 USDT com esta estratégia.
LIVE_MAX_ORDER_QUOTE_VALUE=15
LIVE_MAX_DAILY_QUOTE_VOLUME=45
# false = compra a mercado no gatilho de queda; true exige limit maker (incompatível com BUY mercado)
LIVE_REQUIRE_MAKER_ONLY=false
LIVE_BALANCE_MAX_AGE_MS=10000
LIVE_MARKET_DATA_MAX_AGE_MS=5000
# ≥ MARKET_SPEC_CACHE_TTL_MS (120s por omissão) para não bloquear Auto LIVE com spec em cache
LIVE_MARKET_SPEC_MAX_AGE_MS=180000
LIVE_TEST_MAX_QUOTE_VALUE=5

# --- Auto LIVE Worker (Fase 1.7): FULL AUTO LIVE; desligado por omissão ---
ENABLE_AUTO_LIVE_WORKER=false
AUTO_LIVE_WORKER_INTERVAL_MS=8000
AUTO_LIVE_ORDER_QUOTE_VALUE=15
AUTO_LIVE_TARGET_PROFIT_PCT=0.02
# Obrigatório para operar: valor exatamente como abaixo (confirmação de risco).
AUTO_LIVE_CONFIRM_ENV=
# Opcional: par spot (ex. BTCUSDC). Vazio = usa `market` do Postgres.
AUTO_LIVE_MARKET=
AUTO_LIVE_MIN_RECONCILIATION_SUCCESS_AGE_MS=20000
AUTO_LIVE_MAX_OPEN_CYCLES=1
AUTO_LIVE_COOLDOWN_MS=60000
AUTO_LIVE_REQUIRE_SELL_AFTER_BUY=true
AUTO_LIVE_ALLOW_NEW_BUY_WITH_OPEN_SELL=false
AUTO_LIVE_MAX_CONSECUTIVE_ERRORS=3
AUTO_LIVE_CIRCUIT_BREAKER_COOLDOWN_MS=300000
AUTO_LIVE_BALANCE_DRIFT_LOOKBACK_MS=300000
AUTO_LIVE_MAX_ORDER_STALE_MS=45000

BOT_MARKET=BTCUSDT
BOT_ENABLED=false

BOT_ORDER_QUOTE_SIZE=1
BOT_TARGET_PROFIT_PCT=0.02
BOT_GRID_STEP_PCT=0.02

# --- Estratégia BTC Drop 2K (queda fixa em USDT + 0,0001 BTC por ciclo) ---
BTC_STRATEGY_ENABLED=true
BTC_STRATEGY_MARKET=BTCUSDT
BTC_DROP_BUY_STEP_USDT=2000
BTC_ORDER_BASE_AMOUNT=0.0001
BTC_TARGET_PROFIT_PCT=0.02
BTC_STRATEGY_ANCHOR_MODE=LAST_HIGH

BOT_MAX_OPEN_CYCLES=10
BOT_MAX_QUOTE_ALLOCATION=500
BOT_MIN_QUOTE_BALANCE=1

BOT_FEE_BUFFER_PCT=0
BOT_PRICE_POLL_INTERVAL_MS=3000
BOT_RECONCILIATION_INTERVAL_MS=10000

# --- Dashboard: login + 2FA (desligado por omissão; sem isto qualquer browser vê o painel) ---
# DASHBOARD_AUTH_ENABLED=false
# DASHBOARD_JWT_SECRET=  # mínimo 32 caracteres se AUTH ativo
# DASHBOARD_JWT_EXPIRES_IN=8h
# DASHBOARD_SESSION_COOKIE_NAME=genesis_spot_session
# Vários utilizadores: identificador:senha|outro:outrasenha (primeiro : separa login da senha; o login costuma ser um email)
# DASHBOARD_USERS=admin@exemplo.com:minhaSenhaForte|ops@exemplo.com:outraSenha
# Se o login não for um email válido (ex.: jamanta), o 2FA precisa de destino explícito:
# DASHBOARD_2FA_DELIVER_MAP=jamanta:gustavo.empresarial.br@gmail.com
# DASHBOARD_OTP_TTL_MINUTES=10
# DASHBOARD_OTP_MAX_ATTEMPTS=5
# DASHBOARD_PASSWORD_MAX_FAILS=5
# DASHBOARD_LOCKOUT_MINUTES=30
# DASHBOARD_BLOCK_DOCUMENT_NAV=true
# DASHBOARD_AUTH_RATE_MAX=40
# DASHBOARD_AUTH_RATE_WINDOW_MS=900000
# SMTP_HOST=console → código 2FA só nos logs do Node (dev). Para email real, usa um SMTP normal.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Genesis SPOT <noreply@exemplo.com>"
# DASHBOARD_2FA_EMAIL_SUBJECT=Genesis SPOT — código de acesso
